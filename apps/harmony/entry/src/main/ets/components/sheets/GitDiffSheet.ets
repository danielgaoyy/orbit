import {
  CapsuleSegmentButtonV2,
  LengthMetrics,
  SegmentButtonV2Items
} from '@kit.ArkUI';
import {
  DiffFileDto,
  DiffLineDto,
  FlatDiffRowDto,
  GitCreatePrResultDto,
  GitStashEntryDto,
  basenameOfPath,
  isAutoCollapsedDiffPath
} from '../../model/OrbitTypes';
import { OrbitHarmonyStore } from '../../model/OrbitHarmonyStore';
import { selectDisplayedDiffFiles } from '../../model/OrbitDiffInspectorModel';
import {
  OrbitTokens,
  orbitButtonMeta,
  orbitButtonSubhead,
  orbitInputSubhead,
  orbitSegmentSelectedBg,
  orbitSegmentSelectedFg,
  orbitSpanMonoFont,
  orbitTextMeta,
  orbitTextMono,
  orbitTextSubhead
} from '../../theme/OrbitTokens';
import { OrbitTheme } from '../../theme/OrbitTheme';
import { dismissHarmonyKeyboard } from '../common/OrbitCommonControls';

const INITIAL_DIFF_LINE_CAP: number = 120;

@ComponentV2
export struct GitDiffSheet {
  @Param isEmbeddedPane: boolean = false;
  @Local fileFilterQuery: string = '';
  @Local manuallyExpandedPaths: string[] = [];
  @Local manuallyCollapsedPaths: string[] = [];
  @Local uncappedPaths: string[] = [];
  @Local isRefreshing: boolean = false;
  @Local diffModeItems: SegmentButtonV2Items = new SegmentButtonV2Items([
    { text: 'Unstaged' },
    { text: 'Staged' }
  ]);
  @Local showCommitPanel: boolean = false;
  @Local commitMessageInput: string = '';
  @Local commitAmend: boolean = false;
  @Local showPrPanel: boolean = false;
  @Local prTitleInput: string = '';
  @Local prBodyInput: string = '';
  @Local prDraft: boolean = false;

  private refreshTimerId: number = -1;
  private navPathStack: NavPathStack = new NavPathStack();
  private store: OrbitHarmonyStore = OrbitHarmonyStore.getInstance();

  aboutToAppear(): void {
    this.store.refreshGitCollabStatus();
  }

  aboutToDisappear(): void {
    if (this.refreshTimerId !== -1) {
      clearTimeout(this.refreshTimerId);
      this.refreshTimerId = -1;
    }
  }

  private handlePullRefresh(): void {
    this.isRefreshing = true;
    this.store.pullRefreshGitReview();
    this.store.refreshGitCollabStatus();
    if (this.refreshTimerId !== -1) {
      clearTimeout(this.refreshTimerId);
    }
    this.refreshTimerId = setTimeout(() => {
      this.isRefreshing = false;
      this.refreshTimerId = -1;
    }, 450);
  }

  @Computed
  get displayedDiffFiles(): DiffFileDto[] {
    return selectDisplayedDiffFiles(
      this.store.isDiffTargetPinned,
      this.store.gitDiffFiles,
      this.store.sessionDiffs
    );
  }

  @Computed
  get filteredDiffFiles(): DiffFileDto[] {
    const all = this.displayedDiffFiles;
    const q = this.fileFilterQuery.trim().toLowerCase();
    if (q.length === 0) {
      return all;
    }
    const matched: DiffFileDto[] = [];
    for (let i = 0; i < all.length; i++) {
      const df = all[i];
      if (
        df.path.toLowerCase().indexOf(q) >= 0 ||
        basenameOfPath(df.path).toLowerCase().indexOf(q) >= 0
      ) {
        matched.push(df);
      }
    }
    return matched;
  }

  @Computed
  get allCodeCollapsed(): boolean {
    const files = this.filteredDiffFiles;
    if (files.length === 0) {
      return false;
    }
    let hasCodeFile = false;
    for (let i = 0; i < files.length; i++) {
      const p = files[i].path;
      if (!isAutoCollapsedDiffPath(p)) {
        hasCodeFile = true;
        if (!this.isFileCollapsed(p)) {
          return false;
        }
      }
    }
    if (!hasCodeFile) {
      for (let i = 0; i < files.length; i++) {
        if (!this.isFileCollapsed(files[i].path)) {
          return false;
        }
      }
    }
    return true;
  }

  @Computed
  get flatDiffRows(): FlatDiffRowDto[] {
    const files = this.filteredDiffFiles;
    const rows: FlatDiffRowDto[] = [];
    for (let fIdx = 0; fIdx < files.length; fIdx++) {
      const df: DiffFileDto = files[fIdx];
      const autoGen = isAutoCollapsedDiffPath(df.path);
      const collapsed = this.isFileCollapsed(df.path);
      rows.push({
        key: `hdr_${df.path}_${collapsed ? 'c' : 'e'}_${df.additions}_${df.deletions}`,
        rowKind: 'file_header',
        filePath: df.path,
        additions: df.additions,
        deletions: df.deletions,
        isCollapsed: collapsed,
        isAutoGenerated: autoGen,
        totalLineCount: df.lines.length,
        hiddenLineCount: 0,
        line: null
      });

      if (!collapsed) {
        const isUncapped = this.uncappedPaths.indexOf(df.path) >= 0;
        const limit = isUncapped
          ? df.lines.length
          : Math.min(INITIAL_DIFF_LINE_CAP, df.lines.length);
        for (let lIdx = 0; lIdx < limit; lIdx++) {
          rows.push({
            key: `ln_${df.path}_${lIdx}`,
            rowKind: 'diff_line',
            filePath: df.path,
            additions: 0,
            deletions: 0,
            isCollapsed: false,
            isAutoGenerated: autoGen,
            totalLineCount: df.lines.length,
            hiddenLineCount: 0,
            line: df.lines[lIdx]
          });
        }

        if (!isUncapped && df.lines.length > INITIAL_DIFF_LINE_CAP) {
          rows.push({
            key: `more_${df.path}_${df.lines.length}`,
            rowKind: 'show_more',
            filePath: df.path,
            additions: 0,
            deletions: 0,
            isCollapsed: false,
            isAutoGenerated: autoGen,
            totalLineCount: df.lines.length,
            hiddenLineCount: df.lines.length - INITIAL_DIFF_LINE_CAP,
            line: null
          });
        }
      }
    }
    return rows;
  }

  @Computed
  get branchLabel(): string {
    const st = this.store.gitStatus;
    if (st !== null && st.branch !== null && st.branch.length > 0) {
      let suffix = '';
      if (st.ahead > 0) {
        suffix += ` ↑${st.ahead}`;
      }
      if (st.behind > 0) {
        suffix += ` ↓${st.behind}`;
      }
      return `${st.branch}${suffix}`;
    }
    return basenameOfPath(this.store.resolvedDiffCwd());
  }

  private toggleCollapseExpandCode(): void {
    if (this.allCodeCollapsed) {
      this.manuallyCollapsedPaths = [];
    } else {
      const all = this.displayedDiffFiles;
      const collapsed: string[] = [];
      for (let i = 0; i < all.length; i++) {
        if (!isAutoCollapsedDiffPath(all[i].path)) {
          collapsed.push(all[i].path);
        }
      }
      this.manuallyExpandedPaths = [];
      this.manuallyCollapsedPaths = collapsed;
    }
    this.store.triggerHaptic(8);
  }

  private isFileCollapsed(filePath: string): boolean {
    if (isAutoCollapsedDiffPath(filePath)) {
      return this.manuallyExpandedPaths.indexOf(filePath) < 0;
    }
    return this.manuallyCollapsedPaths.indexOf(filePath) >= 0;
  }

  private toggleFileCollapsed(filePath: string): void {
    if (isAutoCollapsedDiffPath(filePath)) {
      const idx = this.manuallyExpandedPaths.indexOf(filePath);
      this.manuallyExpandedPaths = idx < 0
        ? this.manuallyExpandedPaths.concat([filePath])
        : this.manuallyExpandedPaths.filter((p: string) => p !== filePath);
    } else {
      const idx = this.manuallyCollapsedPaths.indexOf(filePath);
      this.manuallyCollapsedPaths = idx < 0
        ? this.manuallyCollapsedPaths.concat([filePath])
        : this.manuallyCollapsedPaths.filter((p: string) => p !== filePath);
    }
    this.store.triggerHaptic(6);
  }

  private expandAllLinesForFile(filePath: string): void {
    if (this.uncappedPaths.indexOf(filePath) >= 0) {
      return;
    }
    this.uncappedPaths = this.uncappedPaths.concat([filePath]);
    this.store.triggerHaptic(8);
  }

  private formatLineGutter(ln: DiffLineDto): string {
    if (ln.kind === 'hunk_header' || ln.kind === 'meta') {
      return '';
    }
    const oldStr = ln.old_line !== null ? ln.old_line.toString().padStart(3, ' ') : '   ';
    const newStr = ln.new_line !== null ? ln.new_line.toString().padStart(3, ' ') : '   ';
    return `${oldStr} ${newStr} `;
  }

  private horizontalPad(): number {
    return this.isEmbeddedPane ? OrbitTokens.SPACE_MD : OrbitTokens.SPACE_LG;
  }

  @Builder
  private renderDiffMenus() {
    Row({ space: OrbitTokens.SPACE_XS }) {
      Button({ type: ButtonType.Circle, stateEffect: true }) {
        SymbolGlyph($r('sys.symbol.arrow_clockwise'))
          .fontSize(18)
          .renderingStrategy(SymbolRenderingStrategy.SINGLE)
          .fontColor([this.store.palette.iconPrimary])
      }
      .width(OrbitTokens.HIT_COMPACT)
      .height(OrbitTokens.HIT_COMPACT)
      .padding(0)
      .backgroundColor(this.store.palette.subtleSurface)
      .accessibilityText('Refresh Git diff')
      .onClick(() => {
        this.handlePullRefresh();
      })

      if (this.isEmbeddedPane) {
        Button({ type: ButtonType.Circle, stateEffect: true }) {
          SymbolGlyph($r('sys.symbol.xmark'))
            .fontSize(16)
            .renderingStrategy(SymbolRenderingStrategy.SINGLE)
            .fontColor([this.store.palette.iconPrimary])
        }
        .width(OrbitTokens.HIT_COMPACT)
        .height(OrbitTokens.HIT_COMPACT)
        .padding(0)
        .backgroundColor(this.store.palette.subtleSurface)
        .accessibilityText('Close Git Diff Inspector')
        .onClick(() => {
          this.store.closeGitInspector();
          this.store.triggerHaptic(6);
        })
      }
    }
    .padding({ right: OrbitTokens.SPACE_MD })
    .alignItems(VerticalAlign.Center)
  }

  @Builder
  private renderFlatRow(row: FlatDiffRowDto) {
    if (row.rowKind === 'file_header') {
      Button({ type: ButtonType.Normal, stateEffect: true }) {
        Row({ space: OrbitTokens.SPACE_SM }) {
          SymbolGlyph(row.isCollapsed ? $r('sys.symbol.chevron_right') : $r('sys.symbol.chevron_down'))
            .fontSize(13)
            .fontColor([this.store.palette.fgMuted])

          Text(row.filePath)
            .attributeModifier(orbitTextMono(this.store.palette.fgPrimary, FontWeight.Bold))
            .maxLines(1)
            .textOverflow({ overflow: TextOverflow.Ellipsis })
            .layoutWeight(1)

          if (row.isAutoGenerated && row.isCollapsed) {
            Text('Generated')
              .attributeModifier(orbitTextMeta(this.store.palette.fgMuted))
          }

          if (row.additions > 0) {
            Text(`+${row.additions}`)
              .attributeModifier(orbitTextMeta(this.store.palette.statusDirect, FontWeight.Bold))
          }
          if (row.deletions > 0) {
            Text(`-${row.deletions}`)
              .attributeModifier(orbitTextMeta(this.store.palette.statusDanger, FontWeight.Bold))
          }

          Button(
            this.store.gitStagedMode ? $r('app.string.git_unstage') : $r('app.string.git_stage'),
            { type: ButtonType.Capsule, stateEffect: true }
          )
            .attributeModifier(
              orbitButtonMeta(this.store.palette.accentPrimary, this.store.palette.accentPrimarySoft)
            )
            .height(26)
            .padding({ left: 8, right: 8 })
            .enabled(!this.store.gitWriteBusy)
            .onClick(() => {
              if (this.store.gitStagedMode) {
                this.store.gitUnstagePaths([row.filePath], false);
              } else {
                this.store.gitStagePaths([row.filePath], false);
              }
            })
        }
        .width('100%')
        .alignItems(VerticalAlign.Center)
      }
      .width('100%')
      .constraintSize({ minHeight: OrbitTokens.HIT_MIN })
      .padding({ left: OrbitTokens.SPACE_MD, right: OrbitTokens.SPACE_MD })
      .margin({ top: OrbitTokens.SPACE_SM })
      .backgroundColor(this.store.palette.listCard)
      .borderRadius(OrbitTokens.RADIUS_MD)
      .onClick(() => {
        dismissHarmonyKeyboard(this.getUIContext());
        this.toggleFileCollapsed(row.filePath);
      })
    } else if (row.rowKind === 'show_more') {
      Button({ type: ButtonType.Normal, stateEffect: true }) {
        Row({ space: OrbitTokens.SPACE_XS }) {
          Text(`Show all ${row.totalLineCount} lines`)
            .attributeModifier(orbitTextSubhead(this.store.palette.accentPrimary, FontWeight.Medium))
          Text(`(+${row.hiddenLineCount} more)`)
            .attributeModifier(orbitTextMeta(this.store.palette.fgMuted))
        }
      }
      .width('100%')
      .constraintSize({ minHeight: OrbitTokens.HIT_MIN })
      .backgroundColor(this.store.palette.subtleSurface)
      .borderRadius(OrbitTokens.RADIUS_MD)
      .margin({ top: 2, bottom: OrbitTokens.SPACE_XS })
      .onClick(() => {
        this.expandAllLinesForFile(row.filePath);
      })
    } else if (row.line !== null) {
      Row() {
        Text() {
          Span(this.formatLineGutter(row.line))
            .font(orbitSpanMonoFont())
            .fontColor(this.store.palette.fgMuted)
          Span(
            row.line.kind === 'added'
              ? '+ '
              : row.line.kind === 'removed'
                ? '- '
                : row.line.kind === 'hunk_header' || row.line.kind === 'meta'
                  ? ''
                  : '  '
          )
            .font(orbitSpanMonoFont(FontWeight.Bold))
            .fontColor(
              row.line.kind === 'added'
                ? this.store.palette.statusDirect
                : row.line.kind === 'removed'
                  ? this.store.palette.statusDanger
                  : this.store.palette.fgMuted
            )
          Span(row.line.content)
            .font(orbitSpanMonoFont())
            .fontColor(
              row.line.kind === 'added'
                ? this.store.palette.statusDirect
                : row.line.kind === 'removed'
                  ? this.store.palette.statusDanger
                  : row.line.kind === 'hunk_header' || row.line.kind === 'meta'
                    ? this.store.palette.accentPrimary
                    : this.store.palette.fgPrimary
            )
        }
        .copyOption(CopyOptions.LocalDevice)
        .width('100%')
      }
      .width('100%')
      .padding({
        left: OrbitTokens.SPACE_SM,
        right: OrbitTokens.SPACE_SM,
        top: OrbitTokens.SPACE_XS,
        bottom: OrbitTokens.SPACE_XS
      })
      .backgroundColor(
        row.line.kind === 'added'
          ? this.store.palette.diffAddedBg
          : row.line.kind === 'removed'
            ? this.store.palette.diffRemovedBg
            : this.store.palette.code
      )
      .onClick(() => {
        const ln = row.line;
        if (ln !== null && ln.kind !== 'meta' && ln.kind !== 'hunk_header') {
          this.store.quoteDiffLineIntoComposer(row.filePath, ln);
        }
      })
    }
  }

  @Builder
  private renderGitCollabPanels() {
    Column({ space: OrbitTokens.SPACE_SM }) {
      // Compact Git Write Action Strip
      Scroll() {
        Row({ space: OrbitTokens.SPACE_XS }) {
          Button(
            this.store.gitStagedMode ? $r('app.string.git_unstage_all') : $r('app.string.git_stage_all'),
            { type: ButtonType.Capsule, stateEffect: true }
          )
            .attributeModifier(
              orbitButtonMeta(this.store.palette.fgPrimary, this.store.palette.listCard)
            )
            .height(34)
            .padding({ left: 12, right: 12 })
            .border({ width: OrbitTokens.HAIRLINE, color: this.store.palette.hairline })
            .enabled(!this.store.gitWriteBusy)
            .onClick(() => {
              if (this.store.gitStagedMode) {
                this.store.gitUnstagePaths([], true);
              } else {
                this.store.gitStagePaths([], true);
              }
            })

          Button($r('app.string.git_commit'), { type: ButtonType.Capsule, stateEffect: true })
            .attributeModifier(
              orbitButtonMeta(
                this.showCommitPanel ? this.store.palette.onAccent : this.store.palette.fgPrimary,
                this.showCommitPanel ? this.store.palette.accentPrimaryFill : this.store.palette.listCard
              )
            )
            .height(34)
            .padding({ left: 12, right: 12 })
            .border({ width: OrbitTokens.HAIRLINE, color: this.store.palette.hairline })
            .onClick(() => {
              this.showCommitPanel = !this.showCommitPanel;
              if (this.showCommitPanel) {
                this.showPrPanel = false;
              }
            })

          Button($r('app.string.git_pr_section'), { type: ButtonType.Capsule, stateEffect: true })
            .attributeModifier(
              orbitButtonMeta(
                this.showPrPanel ? this.store.palette.onAccent : this.store.palette.fgPrimary,
                this.showPrPanel ? this.store.palette.accentPrimaryFill : this.store.palette.listCard
              )
            )
            .height(34)
            .padding({ left: 12, right: 12 })
            .border({ width: OrbitTokens.HAIRLINE, color: this.store.palette.hairline })
            .onClick(() => {
              this.showPrPanel = !this.showPrPanel;
              if (this.showPrPanel) {
                this.showCommitPanel = false;
                this.store.refreshGitCollabStatus();
              }
            })

          Button($r('app.string.git_stash_save'), { type: ButtonType.Capsule, stateEffect: true })
            .attributeModifier(
              orbitButtonMeta(this.store.palette.fgSecondary, this.store.palette.listCard)
            )
            .height(34)
            .padding({ left: 12, right: 12 })
            .border({ width: OrbitTokens.HAIRLINE, color: this.store.palette.hairline })
            .enabled(!this.store.gitWriteBusy)
            .onClick(() => {
              this.store.gitSaveStash(null, true);
            })

          if (this.store.gitStashes.length > 0) {
            Button($r('app.string.git_stash_pop'), { type: ButtonType.Capsule, stateEffect: true })
              .attributeModifier(
                orbitButtonMeta(this.store.palette.accentPrimary, this.store.palette.accentPrimarySoft)
              )
              .height(34)
              .padding({ left: 12, right: 12 })
              .enabled(!this.store.gitWriteBusy)
              .onClick(() => {
                const top: GitStashEntryDto = this.store.gitStashes[0];
                this.store.gitPopStash(top.stash_ref, top.oid ?? null);
              })
          }
        }
        .padding({ left: this.horizontalPad(), right: this.horizontalPad() })
      }
      .scrollable(ScrollDirection.Horizontal)
      .scrollBar(BarState.Off)
      .width('100%')

      // Conflicts / Active Rebase Alert Strip
      if (this.store.gitConflicts.length > 0 || (this.store.gitRebaseStatus !== null && this.store.gitRebaseStatus.in_progress)) {
        Column({ space: OrbitTokens.SPACE_XS }) {
          Row({ space: OrbitTokens.SPACE_SM }) {
            SymbolGlyph($r('sys.symbol.exclamationmark_triangle_fill'))
              .fontSize(14)
              .fontColor([this.store.palette.statusDanger])
            Text(
              this.store.gitConflicts.length > 0
                ? `${this.store.gitConflicts.length} merge conflict(s)`
                : 'Rebase in progress'
            )
              .attributeModifier(orbitTextMeta(this.store.palette.statusDanger, FontWeight.Bold))
              .layoutWeight(1)
          }
          .width('100%')

          Row({ space: OrbitTokens.SPACE_SM }) {
            Button($r('app.string.git_rebase_continue'), { type: ButtonType.Capsule, stateEffect: true })
              .attributeModifier(orbitButtonMeta(this.store.palette.onAccent, this.store.palette.accentPrimaryFill))
              .height(32)
              .padding({ left: 12, right: 12 })
              .enabled(!this.store.gitWriteBusy)
              .onClick(() => {
                this.store.gitRebaseContinue();
              })
            Button($r('app.string.git_rebase_abort'), { type: ButtonType.Capsule, stateEffect: true })
              .attributeModifier(orbitButtonMeta(this.store.palette.statusDanger, this.store.palette.listCard))
              .height(32)
              .padding({ left: 12, right: 12 })
              .enabled(!this.store.gitWriteBusy)
              .onClick(() => {
                this.store.gitRebaseAbort();
              })
          }
          .width('100%')
        }
        .width('100%')
        .padding(OrbitTokens.SPACE_SM)
        .margin({ left: this.horizontalPad(), right: this.horizontalPad() })
        .backgroundColor(this.store.palette.statusDangerSoft)
        .borderRadius(OrbitTokens.RADIUS_MD)
      }

      // Collapsible Commit Panel
      if (this.showCommitPanel) {
        Column({ space: OrbitTokens.SPACE_SM }) {
          TextArea({
            placeholder: $r('app.string.git_commit_placeholder'),
            text: this.commitMessageInput
          })
            .fontSize(OrbitTokens.FONT_SUBHEAD)
            .fontColor(this.store.palette.fgPrimary)
            .placeholderColor(this.store.palette.fgMuted)
            .backgroundColor(this.store.palette.recessed)
            .borderRadius(OrbitTokens.RADIUS_MD)
            .border({ width: OrbitTokens.HAIRLINE, color: this.store.palette.hairline })
            .padding(OrbitTokens.SPACE_SM)
            .width('100%')
            .constraintSize({ minHeight: 68, maxHeight: 120 })
            .onChange((val: string) => {
              this.commitMessageInput = val;
            })

          Row({ space: OrbitTokens.SPACE_SM }) {
            Toggle({ type: ToggleType.Switch, isOn: this.commitAmend })
              .selectedColor(this.store.palette.accentPrimaryFill)
              .onChange((on: boolean) => {
                this.commitAmend = on;
              })
            Text($r('app.string.git_amend'))
              .attributeModifier(orbitTextMeta(this.store.palette.fgSecondary))
              .layoutWeight(1)

            Button($r('app.string.git_generate_message'), { type: ButtonType.Capsule, stateEffect: true })
              .attributeModifier(orbitButtonMeta(this.store.palette.accentPrimary, this.store.palette.accentPrimarySoft))
              .height(34)
              .padding({ left: 10, right: 10 })
              .enabled(!this.store.gitWriteBusy)
              .onClick(() => {
                this.store.gitGenerateCommitMessage().then((msg: string) => {
                  if (msg.length > 0) {
                    this.commitMessageInput = msg;
                  }
                });
              })

            Button($r('app.string.git_commit'), { type: ButtonType.Capsule, stateEffect: true })
              .attributeModifier(orbitButtonSubhead(this.store.palette.onAccent, this.store.palette.accentPrimaryFill))
              .height(34)
              .padding({ left: 14, right: 14 })
              .enabled(!this.store.gitWriteBusy && this.commitMessageInput.trim().length > 0)
              .onClick(() => {
                dismissHarmonyKeyboard(this.getUIContext());
                this.store.gitCommit(this.commitMessageInput, this.commitAmend).then((ok: boolean) => {
                  if (ok) {
                    this.commitMessageInput = '';
                    this.commitAmend = false;
                    this.showCommitPanel = false;
                  }
                });
              })
          }
          .width('100%')
          .alignItems(VerticalAlign.Center)
        }
        .padding(OrbitTokens.SPACE_MD)
        .margin({ left: this.horizontalPad(), right: this.horizontalPad() })
        .borderRadius(OrbitTokens.RADIUS_MD)
        .attributeModifier(OrbitTheme.raisedCard(this.store.palette))
      }

      // Collapsible Pull Request Panel
      if (this.showPrPanel) {
        Column({ space: OrbitTokens.SPACE_SM }) {
          if (
            this.store.gitPrStatus !== null &&
            this.store.gitPrStatus.number !== undefined &&
            this.store.gitPrStatus.number !== null
          ) {
            Row({ space: OrbitTokens.SPACE_SM }) {
              Text(`#${this.store.gitPrStatus.number} ${this.store.gitPrStatus.title ?? ''}`)
                .attributeModifier(orbitTextSubhead(this.store.palette.fgPrimary, FontWeight.Bold))
                .maxLines(2)
                .layoutWeight(1)
              Text((this.store.gitPrStatus.state ?? 'OPEN').toUpperCase())
                .attributeModifier(orbitTextMeta(this.store.palette.statusDirect, FontWeight.Medium))
                .padding({ left: 8, right: 8, top: 2, bottom: 2 })
                .backgroundColor(this.store.palette.statusDirectSoft)
                .borderRadius(999)
            }
            .width('100%')

            if ((this.store.gitPrStatus.url ?? '').length > 0) {
              Row({ space: OrbitTokens.SPACE_SM }) {
                Text(
                  `${this.store.gitPrStatus.passing_checks ?? 0} passing · ${this.store.gitPrStatus.failing_checks ?? 0} failing`
                )
                  .attributeModifier(orbitTextMeta(this.store.palette.fgMuted))
                  .layoutWeight(1)
                Button($r('app.string.action_copy'), { type: ButtonType.Capsule, stateEffect: true })
                  .attributeModifier(orbitButtonMeta(this.store.palette.fgPrimary, this.store.palette.subtleSurface))
                  .height(30)
                  .padding({ left: 10, right: 10 })
                  .onClick(() => {
                    this.store.copyToClipboard(this.store.gitPrStatus?.url ?? '', 'Copied PR URL');
                  })
              }
              .width('100%')
            }
          } else {
            TextInput({
              placeholder: $r('app.string.git_pr_title_placeholder'),
              text: this.prTitleInput
            })
              .attributeModifier(
                orbitInputSubhead(this.store.palette.fgPrimary, this.store.palette.fgMuted, this.store.palette.recessed)
              )
              .height(OrbitTokens.HIT_COMPACT)
              .borderRadius(OrbitTokens.RADIUS_MD)
              .width('100%')
              .onChange((val: string) => {
                this.prTitleInput = val;
              })

            TextArea({
              placeholder: $r('app.string.git_pr_body_placeholder'),
              text: this.prBodyInput
            })
              .fontSize(OrbitTokens.FONT_SUBHEAD)
              .fontColor(this.store.palette.fgPrimary)
              .placeholderColor(this.store.palette.fgMuted)
              .backgroundColor(this.store.palette.recessed)
              .borderRadius(OrbitTokens.RADIUS_MD)
              .padding(OrbitTokens.SPACE_SM)
              .width('100%')
              .constraintSize({ minHeight: 56, maxHeight: 100 })
              .onChange((val: string) => {
                this.prBodyInput = val;
              })

            Row({ space: OrbitTokens.SPACE_SM }) {
              Toggle({ type: ToggleType.Switch, isOn: this.prDraft })
                .selectedColor(this.store.palette.accentPrimaryFill)
                .onChange((on: boolean) => {
                  this.prDraft = on;
                })
              Text($r('app.string.git_pr_draft'))
                .attributeModifier(orbitTextMeta(this.store.palette.fgSecondary))
                .layoutWeight(1)
              Button($r('app.string.git_create_pr'), { type: ButtonType.Capsule, stateEffect: true })
                .attributeModifier(orbitButtonSubhead(this.store.palette.onAccent, this.store.palette.accentPrimaryFill))
                .height(34)
                .padding({ left: 14, right: 14 })
                .enabled(!this.store.gitWriteBusy && this.prTitleInput.trim().length > 0)
                .onClick(() => {
                  dismissHarmonyKeyboard(this.getUIContext());
                  this.store.gitCreatePr(this.prTitleInput, this.prBodyInput, null, this.prDraft).then(
                    (res: GitCreatePrResultDto | null) => {
                      if (res !== null) {
                        this.prTitleInput = '';
                        this.prBodyInput = '';
                        this.prDraft = false;
                      }
                    }
                  );
                })
            }
            .width('100%')
            .alignItems(VerticalAlign.Center)
          }
        }
        .padding(OrbitTokens.SPACE_MD)
        .margin({ left: this.horizontalPad(), right: this.horizontalPad() })
        .borderRadius(OrbitTokens.RADIUS_MD)
        .attributeModifier(OrbitTheme.raisedCard(this.store.palette))
      }
    }
    .width('100%')
  }

  @Builder
  private renderDiffBody() {
    Column({ space: OrbitTokens.SPACE_MD }) {
      Row() {
        CapsuleSegmentButtonV2({
          items: this.diffModeItems,
          selectedIndex: this.store.gitStagedMode ? 1 : 0,
          onItemClicked: (idx: number) => {
            this.store.setGitStagedMode(idx === 1);
          },
          itemSelectedBackgroundColor: orbitSegmentSelectedBg(this.store.palette),
          itemSelectedFontColor: orbitSegmentSelectedFg(this.store.palette),
          itemMaxFontScale: 1.45,
          itemMinHeight: LengthMetrics.vp(36)
        })
          .width('100%')
      }
      .width('100%')
      .padding({ left: this.horizontalPad(), right: this.horizontalPad() })

      this.renderGitCollabPanels()

      if (this.displayedDiffFiles.length > 0) {
        Row({ space: OrbitTokens.SPACE_SM }) {
          Search({ value: this.fileFilterQuery, placeholder: 'Filter modified files…' })
            .layoutWeight(1)
            .height(OrbitTokens.HIT_COMPACT)
            .backgroundColor(this.store.palette.listCard)
            .placeholderColor(this.store.palette.fgMuted)
            .fontColor(this.store.palette.fgPrimary)
            .textFont({ size: OrbitTokens.FONT_SUBHEAD_RES })
            .placeholderFont({ size: OrbitTokens.FONT_SUBHEAD_RES })
            .maxFontScale(OrbitTokens.MAX_FONT_SCALE_CHROME)
            .onChange((val: string) => {
              this.fileFilterQuery = val;
            })

          Button(this.allCodeCollapsed ? 'Expand' : 'Collapse', { type: ButtonType.Capsule, stateEffect: true })
            .attributeModifier(
              orbitButtonMeta(this.store.palette.fgPrimary, this.store.palette.listCard)
            )
            .height(OrbitTokens.HIT_COMPACT)
            .padding({ left: OrbitTokens.SPACE_MD, right: OrbitTokens.SPACE_MD })
            .onClick(() => {
              dismissHarmonyKeyboard(this.getUIContext());
              this.toggleCollapseExpandCode();
            })
        }
        .width('100%')
        .padding({ left: this.horizontalPad(), right: this.horizontalPad() })

        if (this.filteredDiffFiles.length > 0) {
          Scroll() {
            Row({ space: OrbitTokens.SPACE_SM }) {
              Button('All Files', { type: ButtonType.Capsule, stateEffect: true })
                .attributeModifier(
                  orbitButtonMeta(
                    this.store.gitSelectedPath.length === 0
                      ? this.store.palette.onAccent
                      : this.store.palette.fgPrimary,
                    this.store.gitSelectedPath.length === 0
                      ? this.store.palette.accentPrimaryFill
                      : this.store.palette.listCard
                  )
                )
                .height(OrbitTokens.HIT_COMPACT)
                .padding({ left: OrbitTokens.SPACE_MD, right: OrbitTokens.SPACE_MD })
                .onClick(() => {
                  this.store.selectGitFileFilter('');
                })

              ForEach(
                this.filteredDiffFiles,
                (df: DiffFileDto) => {
                  Button({ type: ButtonType.Capsule, stateEffect: true }) {
                    Row({ space: OrbitTokens.SPACE_XS }) {
                      Text(basenameOfPath(df.path))
                        .attributeModifier(
                          orbitTextMono(
                            this.store.gitSelectedPath === df.path
                              ? this.store.palette.accentPrimary
                              : this.store.palette.fgPrimary,
                            FontWeight.Medium
                          )
                        )
                      Text(`+${df.additions}`)
                        .attributeModifier(
                          orbitTextMeta(this.store.palette.statusDirect, FontWeight.Medium)
                        )
                      Text(`-${df.deletions}`)
                        .attributeModifier(
                          orbitTextMeta(this.store.palette.statusDanger, FontWeight.Medium)
                        )
                    }
                  }
                  .height(OrbitTokens.HIT_COMPACT)
                  .padding({ left: OrbitTokens.SPACE_MD, right: OrbitTokens.SPACE_MD })
                  .backgroundColor(
                    this.store.gitSelectedPath === df.path
                      ? this.store.palette.accentPrimarySoft
                      : this.store.palette.listCard
                  )
                  .onClick(() => {
                    this.store.selectGitFileFilter(df.path);
                  })
                },
                (df: DiffFileDto) => df.path
              )
            }
            .padding({ left: this.horizontalPad(), right: this.horizontalPad() })
          }
          .scrollable(ScrollDirection.Horizontal)
          .scrollBar(BarState.Off)
          .width('100%')
        }
      }

      if (this.displayedDiffFiles.length === 0) {
        Refresh({ refreshing: $$this.isRefreshing }) {
          Column({ space: OrbitTokens.SPACE_SM }) {
            Blank()
            Text('Working tree clean')
              .attributeModifier(orbitTextSubhead(this.store.palette.fgPrimary, FontWeight.Medium))
            Text('No unstaged or session changes in the active workspace.')
              .attributeModifier(orbitTextMeta(this.store.palette.fgMuted))
              .textAlign(TextAlign.Center)
            Blank()
          }
          .width('100%')
          .height('100%')
          .padding({
            left: this.horizontalPad(),
            right: this.horizontalPad(),
            bottom: this.store.keyboardHeightVp > 0
              ? OrbitTokens.SPACE_MD
              : Math.max(OrbitTokens.SPACE_MD, this.store.safeBottomVp)
          })
          .alignItems(HorizontalAlign.Center)
        }
        .onRefreshing(() => {
          this.handlePullRefresh();
        })
        .width('100%')
        .layoutWeight(1)
      } else if (this.filteredDiffFiles.length === 0) {
        Refresh({ refreshing: $$this.isRefreshing }) {
          Column({ space: OrbitTokens.SPACE_SM }) {
            Blank()
            Text('No matching modified files')
              .attributeModifier(orbitTextSubhead(this.store.palette.fgPrimary, FontWeight.Medium))
            Text('Clear the filter above to view all modified files.')
              .attributeModifier(orbitTextMeta(this.store.palette.fgMuted))
              .textAlign(TextAlign.Center)
            Blank()
          }
          .width('100%')
          .height('100%')
          .padding({
            left: this.horizontalPad(),
            right: this.horizontalPad(),
            bottom: this.store.keyboardHeightVp > 0
              ? OrbitTokens.SPACE_MD
              : Math.max(OrbitTokens.SPACE_MD, this.store.safeBottomVp)
          })
          .alignItems(HorizontalAlign.Center)
        }
        .onRefreshing(() => {
          this.handlePullRefresh();
        })
        .width('100%')
        .layoutWeight(1)
      } else {
        Refresh({ refreshing: $$this.isRefreshing }) {
          List({ space: 0 }) {
            Repeat<FlatDiffRowDto>(this.flatDiffRows)
              .each((ri: RepeatItem<FlatDiffRowDto>) => {
                ListItem() {
                  this.renderFlatRow(ri.item)
                }
              })
              .key((row: FlatDiffRowDto) => row.key)
              .virtualScroll()
          }
          .width('100%')
          .height('100%')
          .padding({
            left: this.horizontalPad(),
            right: this.horizontalPad(),
            bottom: this.store.keyboardHeightVp > 0
              ? OrbitTokens.SPACE_MD
              : Math.max(OrbitTokens.SPACE_MD, this.store.safeBottomVp)
          })
          .scrollBar(BarState.Auto)
          .edgeEffect(EdgeEffect.Spring)
          .onScrollStart(() => {
            dismissHarmonyKeyboard(this.getUIContext());
          })
        }
        .onRefreshing(() => {
          this.handlePullRefresh();
        })
        .width('100%')
        .layoutWeight(1)
      }
    }
    .width('100%')
    .height('100%')
    .padding({ top: OrbitTokens.SPACE_XS })
  }

  build() {
    Navigation(this.navPathStack) {
      this.renderDiffBody()
    }
    .title({
      main: this.isEmbeddedPane ? 'Git Inspector' : 'Git Review',
      sub: `${this.branchLabel} · Tap line to quote`
    })
    .titleMode(NavigationTitleMode.Mini)
    .hideBackButton(true)
    .menus(this.renderDiffMenus())
    .mode(NavigationMode.Stack)
    .width('100%')
    .height('100%')
    .backgroundColor(this.store.palette.drawer)
  }
}

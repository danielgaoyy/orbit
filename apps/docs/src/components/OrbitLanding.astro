---
import { getLandingCopy, type LandingLang } from "../data/landing-copy";
import OrbitNavbar from "./OrbitNavbar.astro";
import OrbitFooter from "./OrbitFooter.astro";

interface Props {
  lang: LandingLang;
}

const { lang } = Astro.props;
const isZh = lang === "zh-CN";
const base = import.meta.env.BASE_URL.replace(/\/+$/, "");
const prefix = isZh ? `${base}/zh-cn` : base;
const copy = getLandingCopy(lang, base, prefix);

const releaseBase = "https://github.com/danielgaoyy/orbit/releases/latest/download";
const macUrl = `${releaseBase}/Orbit-macOS-AppleSilicon.dmg`;
const winUrl = `${releaseBase}/Orbit-Windows-x64-setup.exe`;
const linuxUrl = `${releaseBase}/Orbit-Linux-x64.deb`;
const allReleasesUrl = "https://github.com/danielgaoyy/orbit/releases";
const repoUrl = "https://github.com/danielgaoyy/orbit";
const downloadPageUrl = `${prefix}/download/`;
const quickstartUrl = `${prefix}/getting-started/quickstart/`;
const desktopEmbedUrl = `${base}/desktop-demo/index.html?lang=${isZh ? "zh" : "en"}`;

const agentsRow1 = copy.agents.list.filter((a) => a.row === 1);
const agentsRow2 = copy.agents.list.filter((a) => a.row === 2);
const agentsRow3 = copy.agents.list.filter((a) => a.row === 3);

const quotesRow1 = copy.testimonials.items.filter((t) => t.row === 1);
const quotesRow2 = copy.testimonials.items.filter((t) => t.row === 2);
const defaultScenario = copy.pa.scenarios[0];

const faqJsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: copy.faq.items.map((item) => ({
    "@type": "Question",
    name: item.q,
    acceptedAnswer: {
      "@type": "Answer",
      text: item.a,
    },
  })),
});
---

<div class="orbit-landing" data-orbit-landing>
  <OrbitNavbar lang={lang} active="home" pageSlug="" />

  <!-- ======================================================================= -->
  <!-- 1. CENTERED HERO + CAPSULE PILL + LIVE EMBEDDED REAL ORBIT DESKTOP APP  -->
  <!-- ======================================================================= -->
  <section class="orbit-hero">
    <div class="orbit-hero-glow" aria-hidden="true"></div>
    <div class="orbit-wrap orbit-hero-inner">
      <div class="orbit-hero-head">
        <a class="orbit-pill" href={allReleasesUrl} target="_blank" rel="noopener noreferrer">
          <span class="orbit-pill-tag">{copy.hero.pillTag}</span>
          <span>{copy.hero.pillText}</span>
          <span aria-hidden="true">↗</span>
        </a>

        <h1 class="orbit-hero-title">{copy.hero.title}</h1>
        <p class="orbit-hero-sub">{copy.hero.subtitle}</p>

        <div class="orbit-hero-actions">
          <a
            class="orbit-btn orbit-btn-primary"
            href={downloadPageUrl}
            data-os-download
            data-href-mac={macUrl}
            data-href-win={winUrl}
            data-href-linux={linuxUrl}
            data-href-mobile={downloadPageUrl}
            data-label-mac={copy.hero.dlMac}
            data-label-win={copy.hero.dlWin}
            data-label-linux={copy.hero.dlLinux}
            data-label-mobile={copy.hero.dlMobile}
          >
            <svg class="orbit-btn-icon" viewBox="0 0 18 18" fill="none" aria-hidden="true">
              <path d="M9 2.5v8.8m0 0-3.2-3.2M9 11.3l3.2-3.2M3.5 14.5h11" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
            <span data-os-label>{copy.hero.dlNeutral}</span>
          </a>

          <a class="orbit-btn orbit-btn-secondary" href={repoUrl} target="_blank" rel="noopener noreferrer">
            <svg class="orbit-btn-icon" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
              <path
                fill-rule="evenodd"
                clip-rule="evenodd"
                d="M10 1.8a8.2 8.2 0 0 0-2.6 16c.4.1.6-.2.6-.4v-1.4c-2.3.5-2.8-1-2.8-1-.4-.9-.9-1.2-.9-1.2-.8-.5.1-.5.1-.5.8.1 1.3.8 1.3.8.7 1.3 1.9.9 2.4.7.1-.5.3-.9.5-1.1-1.8-.2-3.7-.9-3.7-4 0-.9.3-1.6.8-2.2-.1-.2-.4-1 .1-2.2 0 0 .7-.2 2.3.8a7.8 7.8 0 0 1 4.1 0c1.6-1 2.3-.8 2.3-.8.4 1.2.2 2 .1 2.2.5.6.8 1.3.8 2.2 0 3.1-1.9 3.8-3.7 4 .3.2.5.7.5 1.5v2.2c0 .2.2.5.6.4a8.2 8.2 0 0 0-2.6-16Z"
              />
            </svg>
            <span>{copy.hero.viewGithub}</span>
          </a>
        </div>

        <p class="orbit-hero-meta">{copy.hero.metaLine}</p>
        <a class="orbit-also-line" href={downloadPageUrl}>
          <span>{copy.hero.alsoFor}</span>
          <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>

    <!-- Real Embedded Orbit Desktop React Web App (Auto-Docks Overview HUD on Wide Screens; Review Drawer Closed by Default) -->
    <div class="orbit-wrap-wide orbit-hero-showcase">
      <div class="orbit-desktop-embed">
        <iframe
          src={desktopEmbedUrl}
          title={isZh ? "Orbit Desktop 真实交互预览" : "Orbit Desktop Live Interactive Preview"}
          class="orbit-desktop-iframe"
          loading="eager"
        ></iframe>
      </div>
    </div>
  </section>

  <!-- ======================================================================= -->
  <!-- 2. PERSONAL AGENT: YOU <-> PERSONAL AGENT NEXUS <-> SPECIALIST AGENTS   -->
  <!-- ======================================================================= -->
  <section class="orbit-section orbit-pa-section">
    <div class="orbit-wrap">
      <div class="orbit-center-head">
        <h2 class="orbit-h2-xl">{copy.pa.title}</h2>
        <p class="orbit-sub-center">{copy.pa.subtitle}</p>
        <div class="orbit-hero-actions orbit-actions-tight">
          <a class="orbit-btn orbit-btn-primary" href={`${prefix}/guides/personal-agent/`}>
            <span>{copy.pa.ctaPrimary}</span>
            <span aria-hidden="true">→</span>
          </a>
          <a class="orbit-btn orbit-btn-secondary" href={quickstartUrl}>
            <span>{copy.pa.ctaSecondary}</span>
          </a>
        </div>
      </div>

      <div class="orbit-pa-stage" data-pa-root data-pa-scenarios={JSON.stringify(copy.pa.scenarios)}>
        <!-- Scenario Switcher -->
        <div class="orbit-pa-modes">
          <div class="orbit-seg-bar" role="group" aria-label="Personal Agent scenarios">
            {copy.pa.scenarios.map((sc, idx) => (
              <button
                type="button"
                class="orbit-seg-btn"
                data-pa-scenario={sc.id}
                aria-pressed={idx === 0 ? "true" : "false"}
              >
                {sc.label}
              </button>
            ))}
          </div>
        </div>

        <!-- 3-Column Bidirectional Hub-and-Spoke Flow -->
        <div class="paf-grid">
          <!-- COLUMN 1: YOU (SINGLE POINT OF CONTACT) -->
          <div class="paf-col paf-col-you">
            <div class="paf-col-lbl">{copy.pa.colYou}</div>

            <div class="paf-you-card">
              <div class="paf-you-top">
                <span class="paf-you-badge" data-pa-channel>{defaultScenario.channel}</span>
              </div>
              <p class="paf-you-prompt" data-pa-prompt>"{defaultScenario.userPrompt}"</p>
              <div class="paf-channel-tags">
                {copy.pa.youChannels.map((ch) => (
                  <span>{ch}</span>
                ))}
              </div>
            </div>

            <div class="paf-return-card" data-pa-card data-state="pending">
              <div class="paf-return-head">
                <span class="paf-ret-dot" aria-hidden="true"></span>
                <span>{copy.pa.returnBadge}</span>
              </div>
              <p class="paf-return-summary" data-pa-summary>{defaultScenario.returnedSummary}</p>
              <code class="paf-gate-cmd" data-pa-cmd>{defaultScenario.gateCmd}</code>
              <div class="pa-approval-btns" data-pa-btns>
                <button type="button" class="pa-btn-ok" data-pa-act="approve">{copy.pa.approveBtn}</button>
                <button type="button" class="pa-btn-no" data-pa-act="deny">{copy.pa.denyBtn}</button>
              </div>
              <div
                class="pa-approval-res"
                data-pa-res
                data-ok={copy.pa.approvedNote}
                data-no={copy.pa.deniedNote}
                hidden
              >
                <span data-pa-res-text></span>
                <button type="button" class="pa-btn-reset" data-pa-act="reset">{copy.pa.resetBtn}</button>
              </div>
            </div>
          </div>

          <!-- CONNECTOR 1: BIDIRECTIONAL YOU <-> PERSONAL AGENT -->
          <div class="paf-bridge" aria-hidden="true">
            <svg viewBox="0 0 88 260" fill="none" preserveAspectRatio="none">
              <path d="M 0 76 C 42 76, 46 116, 88 116" stroke="var(--orbit-border-default)" stroke-width="1.4" />
              <path d="M 0 76 C 42 76, 46 116, 88 116" stroke="var(--orbit-accent-cyan)" stroke-width="1.8" class="paf-flow-out" />
              <path d="M 88 156 C 46 156, 42 198, 0 198" stroke="var(--orbit-border-default)" stroke-width="1.4" />
              <path d="M 88 156 C 46 156, 42 198, 0 198" stroke="var(--orbit-success)" stroke-width="1.8" class="paf-flow-back" />
            </svg>
          </div>

          <!-- COLUMN 2: CENTRAL PERSONAL AGENT NEXUS -->
          <div class="paf-col paf-col-hub">
            <div class="paf-col-lbl">{copy.pa.colHub}</div>
            <div class="paf-hub-card">
              <div class="paf-hub-orb" aria-hidden="true">
                <svg viewBox="0 0 28 28" fill="none">
                  <circle cx="14" cy="14" r="10.5" stroke="currentColor" stroke-width="1.4" stroke-opacity="0.4" />
                  <ellipse cx="14" cy="14" rx="11.5" ry="4.8" transform="rotate(-24 14 14)" stroke="currentColor" stroke-width="1.6" />
                  <circle cx="14" cy="14" r="3.2" fill="currentColor" />
                  <circle cx="23.2" cy="9.8" r="2.1" fill="var(--orbit-accent-cyan)" />
                </svg>
              </div>
              <h3>Personal Agent</h3>
              <p class="paf-hub-tag">{copy.pa.hubTagline}</p>

              <ol class="paf-hub-steps" data-pa-steps>
                {defaultScenario.hubSteps.map((s) => (
                  <li>{s}</li>
                ))}
              </ol>

              <div class="paf-hub-foot">
                <span>Noise_NKpsk0 E2EE</span>
                <span>·</span>
                <span>setsid shims</span>
              </div>
            </div>
          </div>

          <!-- CONNECTOR 2: FAN-OUT & CONVERGE PERSONAL AGENT <-> 3 SPECIALISTS -->
          <div class="paf-bridge paf-bridge-fan" aria-hidden="true">
            <svg viewBox="0 0 96 340" fill="none" preserveAspectRatio="none">
              <path d="M 0 158 C 46 158, 42 52, 96 52" stroke="var(--orbit-border-default)" stroke-width="1.3" />
              <path d="M 0 158 C 46 158, 42 52, 96 52" stroke="var(--orbit-accent-cyan)" stroke-width="1.7" class="paf-flow-out" />

              <path d="M 0 170 L 96 170" stroke="var(--orbit-border-default)" stroke-width="1.3" />
              <path d="M 0 170 L 96 170" stroke="var(--orbit-accent-cyan)" stroke-width="1.7" class="paf-flow-out" />

              <path d="M 0 182 C 46 182, 42 288, 96 288" stroke="var(--orbit-border-default)" stroke-width="1.3" />
              <path d="M 0 182 C 46 182, 42 288, 96 288" stroke="var(--orbit-accent-cyan)" stroke-width="1.7" class="paf-flow-out" />

              <path d="M 96 66 C 48 66, 48 164, 0 164" stroke="var(--orbit-success)" stroke-width="1.3" stroke-opacity="0.65" class="paf-flow-back" />
              <path d="M 96 302 C 48 302, 48 190, 0 190" stroke="var(--orbit-success)" stroke-width="1.3" stroke-opacity="0.65" class="paf-flow-back" />
            </svg>
          </div>

          <!-- COLUMN 3: 3 SPECIALIST AGENTS ACROSS HOSTS -->
          <div class="paf-col paf-col-fleet">
            <div class="paf-col-lbl">{copy.pa.colFleet}</div>
            <div class="paf-workers" data-pa-workers>
              {defaultScenario.workers.map((w, idx) => (
                <article class="paf-worker-card" data-worker-idx={idx}>
                  <div class="paf-worker-top">
                    <strong data-w-agent>{w.agent}</strong>
                    <code data-w-host>{w.host}</code>
                  </div>
                  <div class="paf-worker-stage" data-w-stage>{w.stage}</div>
                  <div class="paf-worker-reason" data-w-reason>{w.reason}</div>
                  <div class={`paf-worker-res is-${w.tone}`} data-w-result>{w.result}</div>
                </article>
              ))}
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ======================================================================= -->
  <!-- 3. BRING YOUR OWN AGENT / SUBSCRIPTION                                  -->
  <!-- ======================================================================= -->
  <section class="orbit-section">
    <div class="orbit-wrap">
      <div class="orbit-center-head">
        <h2 class="orbit-h2-xl">{copy.agents.title}</h2>
        <p class="orbit-sub-center">{copy.agents.subtitle}</p>
      </div>

      <div class="orbit-agent-cloud">
        {[agentsRow1, agentsRow2, agentsRow3].map((row, rowIdx) => (
          <div class="orbit-agent-row">
            {row.map((a, idx) => {
              const g = (rowIdx * 8 + idx) % 6;
              return (
                <div class="orbit-agent-pill">
                  <svg class="orbit-agent-glyph" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                    {g === 0 && <path d="M8 1.5v13M1.5 8h13M3.4 3.4l9.2 9.2M12.6 3.4l-9.2 9.2" stroke="currentColor" stroke-width="1.35" stroke-linecap="round" />}
                    {g === 1 && <path d="M3 4.5 6.8 8 3 11.5M8.2 11.5H13" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />}
                    {g === 2 && <path d="M8 2 13.2 5v6L8 14 2.8 11V5L8 2Z" stroke="currentColor" stroke-width="1.35" stroke-linejoin="round" />}
                    {g === 3 && <path d="M8 2.2 9.8 6.2 13.8 8 9.8 9.8 8 13.8 6.2 9.8 2.2 8 6.2 6.2 8 2.2Z" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round" />}
                    {g === 4 && <><circle cx="8" cy="8" r="5.2" stroke="currentColor" stroke-width="1.35" /><circle cx="8" cy="8" r="1.8" fill="currentColor" /></>}
                    {g === 5 && <><rect x="2.5" y="2.5" width="4.4" height="4.4" rx="1" stroke="currentColor" stroke-width="1.3" /><rect x="9.1" y="2.5" width="4.4" height="4.4" rx="1" stroke="currentColor" stroke-width="1.3" /><rect x="2.5" y="9.1" width="4.4" height="4.4" rx="1" stroke="currentColor" stroke-width="1.3" /><rect x="9.1" y="9.1" width="4.4" height="4.4" rx="1" stroke="currentColor" stroke-width="1.3" /></>}
                  </svg>
                  <span>{a.name}</span>
                </div>
              );
            })}
          </div>
        ))}
        <div class="orbit-agent-row">
          <a class="orbit-agent-pill orbit-agent-any" href={quickstartUrl}>
            {copy.agents.anyOther}
          </a>
        </div>
      </div>

      <p class="orbit-migrate-caption">{copy.agents.migrateHint}</p>
    </div>
  </section>

  <!-- ======================================================================= -->
  <!-- 4. RUN ON EVERY DEVICE (iPhone 18 Pro Titanium Bezels + Dynamic Island) -->
  <!-- ======================================================================= -->
  <section class="orbit-section orbit-devices-section">
    <div class="orbit-wrap">
      <div class="orbit-center-head">
        <h2 class="orbit-h2-xl">{copy.devices.title}</h2>
        <p class="orbit-sub-center">{copy.devices.subtitle}</p>
      </div>

      <div class="orbit-hw-trio">
        {copy.devices.cards.map((c, idx) => (
          <figure class={`hw-device-unit ${c.center ? "is-center" : ""}`}>
            <div class={`hw-iphone18 ${c.center ? "is-front" : idx === 0 ? "is-left" : "is-right"}`}>
              <!-- Titanium Physical Hardware Buttons -->
              <span class="hw-btn hw-btn-action" aria-hidden="true"></span>
              <span class="hw-btn hw-btn-vol-up" aria-hidden="true"></span>
              <span class="hw-btn hw-btn-vol-dn" aria-hidden="true"></span>
              <span class="hw-btn hw-btn-pwr" aria-hidden="true"></span>
              <span class="hw-btn hw-btn-cam" aria-hidden="true"></span>

              <div class="hw-screen-frame">
                <!-- Precision iPhone 18 Pro Dynamic Island Overlay -->
                <div class="hw-island-pill" aria-hidden="true">
                  <span class="hw-island-sensor"></span>
                  <span class="hw-island-lens"></span>
                </div>

                <img
                  src={`${base}${c.img}`}
                  alt={c.alt}
                  class="hw-real-shot"
                  width="720"
                  height="1560"
                  loading="lazy"
                  decoding="async"
                />

                <!-- Subtle iOS Home Indicator -->
                <span class="hw-home-indicator" aria-hidden="true"></span>
              </div>
            </div>

            <figcaption class="hw-caption">
              <strong>{c.title}</strong>
              <span>{c.sub}</span>
            </figcaption>
          </figure>
        ))}
      </div>

      <div class="orbit-hw-also">
        <p class="orbit-hw-platforms">{copy.devices.platformStrip}</p>
        <a href={downloadPageUrl}>
          <span>{copy.devices.alsoLink}</span>
          <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </section>

  <!-- ======================================================================= -->
  <!-- 5. AGENT-FIRST, END TO END (Curated 6-Card Asymmetric Flagship Bento)   -->
  <!-- ======================================================================= -->
  <section class="orbit-section">
    <div class="orbit-wrap">
      <div class="orbit-center-head">
        <h2 class="orbit-h2-xl">{copy.bento.title}</h2>
        <p class="orbit-sub-center">{copy.bento.subtitle}</p>
      </div>

      <div class="orbit-bento-6">
        {copy.bento.items.map((item) => (
          <a class={`b6-card ${item.span}`} href={`${prefix}${item.hrefSlug}`}>
            <div class="b6-vig" aria-hidden="true">
              {item.id === "shim" && (
                <div class="b6-shim-art">
                  <div class="b6-shim-top">
                    <span class="mv-chip is-cyan">orbit daemon · upgrading v0.10 → v0.11</span>
                    <span class="mv-chip is-ok">0 dropped turns</span>
                  </div>
                  <div class="b6-shim-lanes">
                    <div class="b6-lane"><code>shim:claude</code><span>setsid · PGID 41820</span><b class="is-ok">ALIVE</b></div>
                    <div class="b6-lane"><code>shim:codex</code><span>wt/e2e · unix.sock</span><b class="is-ok">ALIVE</b></div>
                    <div class="b6-lane"><code>shim:pty-01</code><span>zsh · interactive</span><b class="is-ok">ALIVE</b></div>
                  </div>
                </div>
              )}

              {item.id === "im" && (
                <div class="b6-im-art">
                  <div class="b6-im-head"><span>Slack Socket Mode</span><b>0 webhooks</b></div>
                  <code>git push origin v0.11.0</code>
                  <div class="mv-btn-row"><span class="mv-ok">Approve</span><span class="mv-no">Deny</span></div>
                </div>
              )}

              {item.id === "worktree" && (
                <div class="b6-wt-art">
                  <div class="b6-wt-tree">
                    <div><code>main</code> <span>HEAD</span></div>
                    <div class="mv-cyan-txt"><code>├─ wt/e2e-rotation</code> <span>Claude</span></div>
                    <div class="mv-ok-txt"><code>└─ wt/cargo-tests</code> <span>Codex</span></div>
                  </div>
                  <div class="b6-wt-rewind">Rewind: Turn 18 · Turn 19 · HEAD</div>
                </div>
              )}

              {item.id === "sandbox" && (
                <div class="b6-sec-art">
                  <div class="b6-sec-rows">
                    <div class="mv-row is-deny"><i></i><span>BLOCKED · read ~/.ssh/id_ed25519 (macOS Seatbelt)</span></div>
                    <div class="mv-row is-ok"><i></i><span>ALLOWED · write /workspace/orbit-wt-e2e/**</span></div>
                    <div class="mv-row is-cyan"><i></i><span>EGRESS · api.github.com:443 (DNS-pinned)</span></div>
                  </div>
                  <div class="b6-sec-seal">✓ Audit Chain #4092 · sha256:9f2c…e8a1 · Ed25519 VALID</div>
                </div>
              )}

              {item.id === "patrol" && (
                <div class="b6-patrol-art">
                  <div class="b6-patrol-row">
                    <span class="mv-p1">P1</span>
                    <code>SyncLink.kt:84 · Immutable Blob</code>
                    <span class="mv-fix">Fix with Agent →</span>
                  </div>
                  <div class="b6-fim-preview">
                    <code>rules.push_str(</code>
                    <code class="mv-ghost">"(allow file-write* (subpath root))"</code>
                    <code>);</code>
                  </div>
                </div>
              )}

              {item.id === "e2ee" && (
                <div class="b6-e2ee-art">
                  <div class="b6-e2ee-chain">
                    <span class="mv-chip">Client</span>
                    <span class="b6-wire">Noise_NKpsk0</span>
                    <span class="mv-chip is-cyan">&lt;6MB Blind Relay</span>
                    <span class="b6-wire">0B Plaintext</span>
                    <span class="mv-chip is-ok">Daemon</span>
                  </div>
                  <div class="b6-e2ee-metrics">
                    <span>LAN Direct 1ms</span>
                    <span>·</span>
                    <span>ChaChaPoly-SHA256</span>
                    <span>·</span>
                    <span>Allow-Pubkey ACL</span>
                  </div>
                </div>
              )}
            </div>

            <div class="b6-copy">
              <span class="b6-eyebrow">{item.eyebrow}</span>
              <h3>{item.title}</h3>
              <p>{item.desc}</p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ======================================================================= -->
  <!-- 6. LOVED BY DEVELOPERS (Dual-Row Marquee with Crisp Intact Borders)     -->
  <!-- ======================================================================= -->
  <section class="orbit-section orbit-marquee-section">
    <div class="orbit-wrap">
      <div class="orbit-center-head">
        <h2 class="orbit-h2-xl">{copy.testimonials.title}</h2>
        <p class="orbit-sub-center">{copy.testimonials.subtitle}</p>
      </div>
    </div>

    <div class="orbit-marquee-viewport">
      {[
        { rows: quotesRow1, dir: "is-left" },
        { rows: quotesRow2, dir: "is-right" },
      ].map(({ rows, dir }) => (
        <div class="orbit-marquee-row">
          <div class={`orbit-marquee-track ${dir}`}>
            {[...rows, ...rows].map((t, idx) => (
              <article class="orbit-mq-card" aria-hidden={idx >= rows.length ? "true" : undefined}>
                <div class="oq-top">
                  <div class="oq-author">
                    <span class="oq-avatar-svg" style={`background:${t.avatarBg}`} aria-hidden="true">
                      <svg viewBox="0 0 36 36" fill="none">
                        <circle cx="18" cy="13.2" r="5.4" fill={t.avatarAccent} fill-opacity="0.9" />
                        {t.avatarShape === 0 && (
                          <path d="M7.5 31c1.8-6.4 6.2-9.6 10.5-9.6S26.7 24.6 28.5 31" fill={t.avatarAccent} fill-opacity="0.5" />
                        )}
                        {t.avatarShape === 1 && (
                          <rect x="8.5" y="21.5" width="19" height="10" rx="5" fill={t.avatarAccent} fill-opacity="0.5" />
                        )}
                        {t.avatarShape === 2 && (
                          <path d="M9 31.5c1-5.8 4.8-9.5 9-9.5s8 3.7 9 9.5" stroke={t.avatarAccent} stroke-width="2.4" stroke-linecap="round" />
                        )}
                        {t.avatarShape === 3 && (
                          <path d="M8 31c2.2-5.5 6-8.6 10-8.6s7.8 3.1 10 8.6" fill={t.avatarAccent} fill-opacity="0.45" stroke={t.avatarAccent} stroke-width="1.3" />
                        )}
                      </svg>
                    </span>
                    <div class="oq-author-meta">
                      <strong>{t.role}</strong>
                      <span>{t.setup}</span>
                    </div>
                  </div>
                  <span class="oq-tag">{t.tag}</span>
                </div>
                <p class="oq-text">{t.quote}</p>
              </article>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- ======================================================================= -->
  <!-- 7. CAPABILITY COMPARISON TABLE                                          -->
  <!-- ======================================================================= -->
  <section class="orbit-section">
    <div class="orbit-wrap">
      <div class="orbit-compare-head">
        <h2 class="orbit-h2-xl orbit-compare-title">{copy.compare.title}</h2>
        <p class="orbit-compare-sub">{copy.compare.subtitle}</p>
      </div>

      <div class="orbit-compare-card">
        <table class="orbit-compare-table">
          <colgroup>
            <col style="width: 60%" />
            <col style="width: 18%" />
            <col style="width: 22%" />
          </colgroup>
          <thead>
            <tr>
              <th>{copy.compare.colCap}</th>
              <th class="col-center col-orbit">{copy.compare.colOrbit}</th>
              <th class="col-center">{copy.compare.colOthers}</th>
            </tr>
          </thead>
          <tbody>
            {copy.compare.rows.map((r) => (
              <tr>
                <td>{r.capability}</td>
                <td class="col-center col-orbit"><span class="cmp-yes">{r.orbit}</span></td>
                <td class="col-center col-other">{r.others}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- ======================================================================= -->
  <!-- 8. FREQUENTLY ASKED QUESTIONS (ALL COLLAPSED BY DEFAULT)                -->
  <!-- ======================================================================= -->
  <section class="orbit-section" id="faq">
    <div class="orbit-wrap orbit-faq-wrap">
      <div class="orbit-center-head">
        <h2 class="orbit-h2-xl">{copy.faq.title}</h2>
        <p class="orbit-sub-center">{copy.faq.subtitle}</p>
      </div>

      <div class="orbit-faq-cards" data-faq-root>
        {copy.faq.items.map((item, idx) => (
          <div class="orbit-faq-card" data-faq-item data-open="false">
            <button
              type="button"
              class="orbit-faq-trigger"
              data-faq-trigger
              aria-expanded="false"
              aria-controls={`orbit-faq-panel-${idx}`}
            >
              <span class="orbit-faq-q" id={`orbit-faq-q-${idx}`}>{item.q}</span>
              <span class="orbit-faq-ico" aria-hidden="true">
                <svg viewBox="0 0 16 16" fill="none">
                  <path d="M8 3.5v9M3.5 8h9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
                </svg>
              </span>
            </button>
            <div
              class="orbit-faq-panel"
              id={`orbit-faq-panel-${idx}`}
              role="region"
              aria-labelledby={`orbit-faq-q-${idx}`}
            >
              <div class="orbit-faq-inner">
                <p>{item.a}</p>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ======================================================================= -->
  <!-- 9. GET ORBIT FINAL CTA (Desktop Download Only) + SHARED FOOTER          -->
  <!-- ======================================================================= -->
  <section class="orbit-section orbit-final-cta" id="download">
    <div class="orbit-cta-glow" aria-hidden="true"></div>
    <div class="orbit-wrap orbit-final-inner">
      <h2 class="orbit-final-title">{copy.cta.title}</h2>
      <p class="orbit-final-sub">{copy.cta.subtitle}</p>

      <div class="orbit-hero-actions">
        <a
          class="orbit-btn orbit-btn-primary"
          href={downloadPageUrl}
          data-os-download
          data-href-mac={macUrl}
          data-href-win={winUrl}
          data-href-linux={linuxUrl}
          data-href-mobile={downloadPageUrl}
          data-label-mac={copy.hero.dlMac}
          data-label-win={copy.hero.dlWin}
          data-label-linux={copy.hero.dlLinux}
          data-label-mobile={copy.hero.dlMobile}
        >
          <svg class="orbit-btn-icon" viewBox="0 0 18 18" fill="none" aria-hidden="true">
            <path d="M9 2.5v8.8m0 0-3.2-3.2M9 11.3l3.2-3.2M3.5 14.5h11" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
          <span data-os-label>{copy.hero.dlNeutral}</span>
        </a>

        <a class="orbit-btn orbit-btn-secondary" href={quickstartUrl}>
          <span>{copy.cta.readDocs}</span>
          <span aria-hidden="true">→</span>
        </a>
      </div>

      <a class="orbit-also-line" href={downloadPageUrl}>
        <span>{copy.cta.alsoFor}</span>
        <span aria-hidden="true">→</span>
      </a>
    </div>
  </section>

  <OrbitFooter lang={lang} />
  <script type="application/ld+json" set:html={faqJsonLd} />
</div>

<script>
  import { animate, inView, stagger } from "motion";
  import { detectClientPlatform, hydrateOsDownloadButtons } from "../scripts/os-detect";

  (() => {
    const root = document.querySelector<HTMLElement>("[data-orbit-landing]");
    if (!root) return;

    // 1. OS Auto-Detection (desktop -> direct binary; mobile -> /download/)
    hydrateOsDownloadButtons(root, detectClientPlatform());

    // 2. Personal Agent 3-Column Hub-and-Spoke Scenario Switcher + Approval Gate
    const paRoot = root.querySelector<HTMLElement>("[data-pa-root]");
    if (paRoot) {
      let scenarios: Array<{
        id: string;
        channel: string;
        userPrompt: string;
        hubSteps: string[];
        workers: Array<{ agent: string; host: string; stage: string; reason: string; result: string; tone: string }>;
        returnedSummary: string;
        gateCmd: string;
      }> = [];
      try {
        scenarios = JSON.parse(paRoot.dataset.paScenarios || "[]");
      } catch {}

      const scBtns = paRoot.querySelectorAll<HTMLButtonElement>("[data-pa-scenario]");
      const elChannel = paRoot.querySelector<HTMLElement>("[data-pa-channel]");
      const elPrompt = paRoot.querySelector<HTMLElement>("[data-pa-prompt]");
      const elSteps = paRoot.querySelector<HTMLElement>("[data-pa-steps]");
      const elSummary = paRoot.querySelector<HTMLElement>("[data-pa-summary]");
      const elCmd = paRoot.querySelector<HTMLElement>("[data-pa-cmd]");
      const workerCards = paRoot.querySelectorAll<HTMLElement>("[data-worker-idx]");
      const card = paRoot.querySelector<HTMLElement>("[data-pa-card]");
      const btnsWrap = paRoot.querySelector<HTMLElement>("[data-pa-btns]");
      const resWrap = paRoot.querySelector<HTMLElement>("[data-pa-res]");
      const resText = paRoot.querySelector<HTMLElement>("[data-pa-res-text]");

      const resetApproval = () => {
        if (!card || !btnsWrap || !resWrap) return;
        card.setAttribute("data-state", "pending");
        btnsWrap.hidden = false;
        resWrap.hidden = true;
      };

      scBtns.forEach((btn) => {
        btn.addEventListener("click", () => {
          const target = scenarios.find((s) => s.id === btn.dataset.paScenario);
          if (!target) return;
          scBtns.forEach((b) => b.setAttribute("aria-pressed", b === btn ? "true" : "false"));

          if (elChannel) elChannel.textContent = target.channel;
          if (elPrompt) elPrompt.textContent = `"${target.userPrompt}"`;
          if (elSummary) elSummary.textContent = target.returnedSummary;
          if (elCmd) elCmd.textContent = target.gateCmd;
          if (elSteps) {
            elSteps.innerHTML = "";
            target.hubSteps.forEach((txt) => {
              const li = document.createElement("li");
              li.textContent = txt;
              elSteps.appendChild(li);
            });
          }

          workerCards.forEach((wc, idx) => {
            const w = target.workers[idx];
            if (!w) return;
            const wAgent = wc.querySelector<HTMLElement>("[data-w-agent]");
            const wHost = wc.querySelector<HTMLElement>("[data-w-host]");
            const wStage = wc.querySelector<HTMLElement>("[data-w-stage]");
            const wReason = wc.querySelector<HTMLElement>("[data-w-reason]");
            const wResult = wc.querySelector<HTMLElement>("[data-w-result]");
            if (wAgent) wAgent.textContent = w.agent;
            if (wHost) wHost.textContent = w.host;
            if (wStage) wStage.textContent = w.stage;
            if (wReason) wReason.textContent = w.reason;
            if (wResult) {
              wResult.textContent = w.result;
              wResult.className = `paf-worker-res is-${w.tone}`;
            }
          });
          resetApproval();
        });
      });

      paRoot.querySelectorAll<HTMLButtonElement>("[data-pa-act]").forEach((btn) => {
        btn.addEventListener("click", () => {
          const act = btn.dataset.paAct;
          if (!card || !btnsWrap || !resWrap || !resText) return;
          if (act === "reset") {
            resetApproval();
          } else if (act === "approve") {
            card.setAttribute("data-state", "approved");
            btnsWrap.hidden = true;
            resWrap.hidden = false;
            resText.textContent = resWrap.dataset.ok || "";
          } else if (act === "deny") {
            card.setAttribute("data-state", "denied");
            btnsWrap.hidden = true;
            resWrap.hidden = false;
            resText.textContent = resWrap.dataset.no || "";
          }
        });
      });
    }

    // 3. Smooth Animated FAQ Accordion (All Collapsed by Default)
    root.querySelectorAll<HTMLElement>("[data-faq-item]").forEach((item) => {
      const trigger = item.querySelector<HTMLButtonElement>("[data-faq-trigger]");
      trigger?.addEventListener("click", () => {
        const next = item.getAttribute("data-open") !== "true";
        item.setAttribute("data-open", next ? "true" : "false");
        trigger.setAttribute("aria-expanded", next ? "true" : "false");
      });
    });

    // 4. rAF-Throttled Pointer Spotlight Sheen on Bento Cards (Desktop Fine Pointers Only)
    if (!window.matchMedia("(pointer: coarse)").matches) {
      root.querySelectorAll<HTMLElement>(".b6-card").forEach((card) => {
        let rafId = 0;
        card.addEventListener("pointermove", (e) => {
          if (rafId) return;
          const x = e.clientX;
          const y = e.clientY;
          rafId = window.requestAnimationFrame(() => {
            const rect = card.getBoundingClientRect();
            card.style.setProperty("--mx", `${x - rect.left}px`);
            card.style.setProperty("--my", `${y - rect.top}px`);
            rafId = 0;
          });
        });
      });
    }

    // 5. Smooth Scroll Choreography via Motion (respects prefers-reduced-motion)
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    if (!reduceMotion) {
      const ease: [number, number, number, number] = [0.22, 1, 0.36, 1];
      const clearInlineMotion = (targets: HTMLElement[]) => {
        targets.forEach((t) => {
          t.style.opacity = "";
          t.style.transform = "";
        });
      };

      const heroEls = Array.from(root.querySelectorAll<HTMLElement>(".orbit-hero-head > *, .orbit-hero-showcase"));
      if (heroEls.length > 0) {
        const heroCtrl = animate(
          heroEls,
          { opacity: [0, 1], transform: ["translateY(12px)", "translateY(0px)"] },
          { duration: 0.5, delay: stagger(0.045), ease },
        );
        heroCtrl.finished.then(() => clearInlineMotion(heroEls)).catch(() => {});
      }

      const revealBlock = (el: HTMLElement, y = 16) => {
        if (el.getBoundingClientRect().top <= window.innerHeight * 0.92) return;
        el.style.opacity = "0";
        el.style.transform = `translateY(${y}px)`;
        inView(
          el,
          () => {
            const controls = animate(
              el,
              { opacity: [0, 1], transform: [`translateY(${y}px)`, "translateY(0px)"] },
              { duration: 0.48, ease },
            );
            controls.finished.then(() => clearInlineMotion([el])).catch(() => {});
          },
          { margin: "0px 0px -48px 0px" },
        );
      };

      const revealGroup = (containerSel: string, itemSel: string, step = 0.04, y = 14) => {
        const container = root.querySelector<HTMLElement>(containerSel);
        if (!container) return;
        const items = Array.from(container.querySelectorAll<HTMLElement>(itemSel));
        if (items.length === 0) return;
        if (container.getBoundingClientRect().top <= window.innerHeight * 0.92) return;
        items.forEach((it) => {
          it.style.opacity = "0";
          it.style.transform = `translateY(${y}px)`;
        });
        inView(
          container,
          () => {
            const controls = animate(
              items,
              { opacity: [0, 1], transform: [`translateY(${y}px)`, "translateY(0px)"] },
              { duration: 0.46, delay: stagger(step), ease },
            );
            controls.finished.then(() => clearInlineMotion(items)).catch(() => {});
          },
          { margin: "0px 0px -40px 0px" },
        );
      };

      root.querySelectorAll<HTMLElement>(".orbit-center-head, .orbit-compare-head, .orbit-final-inner").forEach((el) =>
        revealBlock(el, 16),
      );
      root.querySelectorAll<HTMLElement>(".orbit-pa-stage, .orbit-compare-card").forEach((el) =>
        revealBlock(el, 18),
      );

      revealGroup(".orbit-agent-cloud", ".orbit-agent-pill", 0.015, 10);
      revealGroup(".orbit-hw-trio", ".hw-device-unit", 0.08, 18);
      revealGroup(".orbit-bento-6", ".b6-card", 0.045, 16);
      revealGroup(".orbit-faq-cards", ".orbit-faq-card", 0.035, 12);
    }
  })();
</script>

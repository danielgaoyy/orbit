---
// Orbit brand mark ("sliced O"): ring pierced by an inclined orbit with a satellite.
// Geometry mirrors docs/assets/brand/orbit-mark.svg (generated by scripts/brand/generate-brand-svgs.py).
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
// Each instance needs its own mask id; several marks render on the same page.
const cutId = `orbit-mark-cut-${Math.random().toString(36).slice(2, 8)}`;
const front = "M28.01 9.62A13.6 3.6 -28 0 1 3.99 22.38";
const back = "M3.99 22.38A13.6 3.6 -28 0 1 28.01 9.62";
---

<svg class={className} viewBox="0 0 32 32" fill="none" aria-hidden="true">
  <defs>
    <mask id={cutId} maskUnits="userSpaceOnUse" x="0" y="0" width="32" height="32">
      <rect width="32" height="32" fill="#fff" />
      <path d={front} stroke="#000" stroke-width="3.6" />
    </mask>
  </defs>
  <path d={back} stroke="currentColor" stroke-opacity="0.45" stroke-width="1.4" stroke-linecap="round" />
  <circle cx="16" cy="16" r="7.7" stroke="currentColor" stroke-width="3.2" mask={`url(#${cutId})`} />
  <path d={front} stroke="currentColor" stroke-width="1.4" stroke-linecap="round" />
  <circle cx="27.66" cy="9.23" r="2.2" fill="#3ED598" />
</svg>

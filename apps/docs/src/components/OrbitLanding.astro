<div class="orbit-landing" data-orbit-landing>
  <!-- ===================================================================== -->
  <!-- 1. HERO + INTERACTIVE PERSONAL AGENT FLEET DISPATCH TOPOLOGY          -->
  <!-- ===================================================================== -->
  <section class="orbit-hero">
    <div class="orbit-wrap orbit-hero-inner">
      <div class="orbit-hero-grid">
        <div>
          <span class="orbit-pill-badge">
            <span class="orbit-eyebrow-dot" aria-hidden="true"></span>
            {copy.badge}
          </span>

          <h1 class="orbit-hero-title">
            {copy.heroLine1}
            <br />
            <em>{copy.heroLine2}</em>
          </h1>

          <p class="orbit-hero-sub">{copy.heroSub}</p>

          <div class="orbit-cta-row">
            <a class="orbit-btn orbit-btn-primary" href={`${prefix}/getting-started/quickstart/`}>
              {copy.ctaPrimary}
              <span aria-hidden="true">→</span>
            </a>
            <a class="orbit-btn orbit-btn-secondary" href={`${prefix}/guides/personal-agent/`}>
              {copy.ctaSecondary}
            </a>
          </div>

          <div class="orbit-telemetry-strip">
            {copy.stats.map((s) => (
              <div>
                <div class="orbit-stat-val">{s.val}</div>
                <div class="orbit-stat-lbl">{s.label}</div>
              </div>
            ))}
          </div>
        </div>

        <!-- Live Interactive Personal Agent Fleet Dispatch SVG Topology -->
        <div class="orbit-topo-card" data-topo-root data-mode="dispatch">
          <div class="orbit-topo-header">
            <span class="orbit-topo-title">
              <span class="orbit-eyebrow-dot" aria-hidden="true"></span>
              {copy.topoTitle}
            </span>
            <div class="orbit-seg" role="group" aria-label={copy.topoTitle}>
              {copy.tabs.map((tab, idx) => (
                <button
                  type="button"
                  class="orbit-seg-btn"
                  data-topo-tab={tab.id}
                  data-topo-tag={tab.tag}
                  data-topo-tone={tab.tone}
                  data-topo-summary={tab.summary}
                  aria-pressed={idx === 0 ? "true" : "false"}
                >
                  {tab.label}
                </button>
              ))}
            </div>
          </div>

          <div class="orbit-topo-stage">
            <svg
              class="orbit-topo-svg"
              viewBox="0 0 640 436"
              fill="none"
              xmlns="http://www.w3.org/2000/svg"
              role="img"
              aria-label={copy.topoTitle}
            >
              <!-- Subtle architectural orbital geometry -->
              <circle cx="320" cy="196" r="158" stroke="var(--orbit-ring-stroke)" stroke-width="1" stroke-dasharray="3 5" />
              <circle cx="320" cy="196" r="106" stroke="var(--orbit-ring-stroke)" stroke-width="1" />
              <ellipse
                cx="320"
                cy="196"
                rx="222"
                ry="62"
                transform="rotate(-11 320 196)"
                stroke="var(--orbit-ring-stroke)"
                stroke-width="1"
              />

              <!-- Top: Omnichannel Input Bar (Human Entry) -->
              <rect
                x="110"
                y="14"
                width="420"
                height="58"
                rx="11"
                fill="var(--orbit-surface-recessed)"
                stroke="var(--orbit-border-default)"
                stroke-width="1"
              />
              <circle cx="132" cy="34" r="3.5" fill="var(--orbit-success)" />
              <text
                x="144"
                y="38"
                fill="var(--orbit-ink-tertiary)"
                font-family="var(--sl-font-mono)"
                font-size="10.2"
                font-weight="600"
                letter-spacing="0.06em"
              >
                {copy.svg.channelsTitle}
              </text>
              <text
                x="132"
                y="57"
                fill="var(--orbit-ink-primary)"
                font-family="var(--sl-font)"
                font-size="12.5"
                font-weight="500"
              >
                {copy.svg.channelsList}
              </text>

              <!-- Vertical Bidirectional Conduit: Human <-> Personal Agent -->
              <line
                x1="308"
                y1="72"
                x2="308"
                y2="146"
                stroke="var(--orbit-info)"
                stroke-width="1.6"
                class="orbit-flow-line"
                data-flow="dispatch"
              />
              <line
                x1="332"
                y1="146"
                x2="332"
                y2="72"
                stroke="var(--orbit-warning)"
                stroke-width="1.6"
                class="orbit-flow-line"
                data-flow="guardian"
                opacity="0.35"
              />

              <!-- Center Hub: Persistent Personal Agent -->
              <rect
                x="180"
                y="146"
                width="280"
                height="76"
                rx="13"
                fill="var(--orbit-surface-base)"
                stroke="var(--orbit-border-strong)"
                stroke-width="1.4"
              />
              <circle
                cx="206"
                cy="184"
                r="14"
                fill="var(--orbit-surface-recessed)"
                stroke="var(--orbit-ring-accent)"
                stroke-width="1.2"
              />
              <circle cx="206" cy="184" r="4.5" fill="var(--orbit-ink-primary)" />
              <circle
                cx="206"
                cy="184"
                r="10"
                stroke="var(--orbit-success)"
                stroke-width="1.1"
                stroke-dasharray="4 3"
                class="orbit-pulse-ring"
              />
              <text
                x="232"
                y="174"
                fill="var(--orbit-ink-primary)"
                font-family="var(--sl-font-mono)"
                font-size="12.5"
                font-weight="700"
                letter-spacing="0.04em"
              >
                {copy.svg.centerRole}
              </text>
              <text
                x="232"
                y="194"
                fill="var(--orbit-ink-secondary)"
                font-family="var(--sl-font)"
                font-size="11.5"
              >
                {copy.svg.centerSub}
              </text>
              <rect
                x="232"
                y="202"
                width="104"
                height="13"
                rx="4"
                fill="var(--orbit-success-bg)"
              />
              <text
                x="239"
                y="211.5"
                fill="var(--orbit-success)"
                font-family="var(--sl-font-mono)"
                font-size="8.8"
                font-weight="600"
              >
                chief-of-staff · LIVE
              </text>

              <!-- Fan-out Dispatch Lines from Personal Agent to 4 Fleet Nodes -->
              <path
                d="M240 222 C240 282, 86 266, 86 306"
                stroke="var(--orbit-success)"
                stroke-width="1.5"
                class="orbit-flow-line"
                data-flow="workers"
              />
              <path
                d="M292 222 C292 278, 242 272, 242 306"
                stroke="var(--orbit-info)"
                stroke-width="1.5"
                class="orbit-flow-line"
                data-flow="workers"
              />
              <path
                d="M348 222 C348 278, 398 272, 398 306"
                stroke="var(--orbit-info)"
                stroke-width="1.5"
                class="orbit-flow-line"
                data-flow="workers"
              />
              <path
                d="M400 222 C400 282, 554 266, 554 306"
                stroke="var(--orbit-success)"
                stroke-width="1.5"
                class="orbit-flow-line"
                data-flow="workers"
              />

              <!-- E2EE Bus Pill (rendered ABOVE flow paths so text stays 100% crisp) -->
              <rect
                x="116"
                y="246"
                width="408"
                height="24"
                rx="12"
                fill="var(--orbit-surface-recessed)"
                stroke="var(--orbit-border-default)"
                stroke-width="1"
              />
              <text
                x="320"
                y="261.5"
                text-anchor="middle"
                fill="var(--orbit-ink-secondary)"
                font-family="var(--sl-font-mono)"
                font-size="9.6"
              >
                {copy.svg.e2eeLabel}
              </text>

              <!-- 4 Fleet Execution Nodes -->
              {copy.svg.nodes.map((node, i) => {
                const x = 14 + i * 156;
                const dotColor = i === 1 ? "var(--orbit-warning)" : "var(--orbit-success)";
                return (
                  <g>
                    <rect
                      x={x}
                      y="306"
                      width="144"
                      height="84"
                      rx="10"
                      fill="var(--orbit-surface-base)"
                      stroke="var(--orbit-border-default)"
                      stroke-width="1"
                    />
                    {/* Detached Shim boundary dashed footer */}
                    <line
                      x1={x + 10}
                      y1="364"
                      x2={x + 134}
                      y2="364"
                      stroke="var(--orbit-border-subtle)"
                      stroke-dasharray="3 3"
                    />
                    <circle cx={x + 14} cy="324" r="3.2" fill={dotColor} />
                    <text
                      x={x + 24}
                      y="328"
                      fill="var(--orbit-ink-primary)"
                      font-family="var(--sl-font-mono)"
                      font-size="11"
                      font-weight="600"
                    >
                      {node.title}
                    </text>
                    <text
                      x={x + 12}
                      y="349"
                      fill="var(--orbit-ink-secondary)"
                      font-family="var(--sl-font)"
                      font-size="10.4"
                    >
                      {node.sub}
                    </text>
                    <text
                      x={x + 12}
                      y="379"
                      fill="var(--orbit-ink-tertiary)"
                      font-family="var(--sl-font-mono)"
                      font-size="9.4"
                    >
                      shim · {node.badge}
                    </text>
                  </g>
                );
              })}

              <!-- Dynamic Mode Callout Strip -->
              <rect
                x="14"
                y="404"
                width="612"
                height="24"
                rx="6"
                fill="var(--orbit-surface-recessed)"
              />
              <text
                x="320"
                y="419.5"
                text-anchor="middle"
                fill="var(--orbit-ink-secondary)"
                font-family="var(--sl-font-mono)"
                font-size="10"
                data-svg-banner
                data-banner-dispatch={copy.svg.e2eeLabel}
                data-banner-guardian={copy.svg.gateNote}
                data-banner-shim={copy.svg.shimNote}
              >
                {copy.svg.e2eeLabel}
              </text>
            </svg>
          </div>

          <div class="orbit-topo-footer">
            <span class="orbit-topo-tag" data-topo-active-tag data-tone="success">
              {copy.tabs[0].tag}
            </span>
            <span data-topo-active-summary>{copy.tabs[0].summary}</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===================================================================== -->
  <!-- 2. INTERACTIVE LIGHT / DARK REAL PRODUCT SHOWCASE                     -->
  <!-- ===================================================================== -->
  <section class="orbit-section">
    <div class="orbit-wrap">
      <div class="orbit-showcase-head">
        <div>
          <span class="orbit-eyebrow">{copy.showcaseEyebrow}</span>
          <h2 class="orbit-h2">{copy.showcaseH2}</h2>
          <p class="orbit-lead">{copy.showcaseLead}</p>
        </div>

        <div class="orbit-seg" role="group" aria-label="Theme preview">
          <button
            type="button"
            class="orbit-seg-btn"
            data-preview-theme="dark"
            aria-pressed="true"
          >
            {copy.themeDark}
          </button>
          <button
            type="button"
            class="orbit-seg-btn"
            data-preview-theme="light"
            aria-pressed="false"
          >
            {copy.themeLight}
          </button>
        </div>
      </div>

      <div class="orbit-frame-shell">
        <div class="orbit-frame-bar">
          <span class="orbit-frame-meta">
            <span class="orbit-eyebrow-dot" aria-hidden="true"></span>
            {copy.frameMeta}
          </span>
          <span>2880 × 1800 · 2× Retina</span>
        </div>
        <div class="orbit-frame-viewport">
          <img
            src="/images/orbit-desktop-dark.png"
            alt="Orbit Desktop in Obsidian Graphite dark theme showing multi-host fleet sidebar, Personal Agent orchestrating 3 subagents, Plan shelf, and syntax-highlighted Git Review Diff"
            class="orbit-frame-img"
            data-preview-img="dark"
            data-visible="true"
            width="2880"
            height="1800"
            loading="eager"
          />
          <img
            src="/images/orbit-desktop-light.png"
            alt="Orbit Desktop in Alabaster Paper light theme showing multi-host fleet sidebar, Personal Agent orchestrating 3 subagents, Plan shelf, and syntax-highlighted Git Review Diff"
            class="orbit-frame-img"
            data-preview-img="light"
            data-visible="false"
            width="2880"
            height="1800"
            loading="lazy"
          />
        </div>
      </div>

      <div class="orbit-caption-grid">
        {copy.captions.map((cap) => (
          <div class="orbit-caption-item">
            <div class="orbit-caption-num">{cap.num}</div>
            <div class="orbit-caption-title">{cap.title}</div>
            <div class="orbit-caption-desc">{cap.desc}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ===================================================================== -->
  <!-- 3. WHY ORBIT VS SINGLE-MACHINE WRAPPERS (DIFFERENTIATION MATRIX)      -->
  <!-- ===================================================================== -->
  <section class="orbit-section">
    <div class="orbit-wrap">
      <span class="orbit-eyebrow">{copy.diffEyebrow}</span>
      <h2 class="orbit-h2">{copy.diffH2}</h2>
      <p class="orbit-lead">{copy.diffLead}</p>

      <div class="orbit-matrix-wrap">
        <table class="orbit-matrix">
          <thead>
            <tr>
              <th>{copy.diffColDim}</th>
              <th>{copy.diffColOther}</th>
              <th class="col-orbit">{copy.diffColOrbit}</th>
            </tr>
          </thead>
          <tbody>
            {copy.diffRows.map((row) => (
              <tr>
                <td class="col-dim">{row.dim}</td>
                <td class="col-other">{row.other}</td>
                <td class="col-orbit">
                  <span class="orbit-check" aria-hidden="true">✓</span>
                  {row.orbit}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- ===================================================================== -->
  <!-- 4. ASYMMETRIC CAPABILITY PILLARS BENTO                                -->
  <!-- ===================================================================== -->
  <section class="orbit-section">
    <div class="orbit-wrap">
      <span class="orbit-eyebrow">{copy.pillarsEyebrow}</span>
      <h2 class="orbit-h2">{copy.pillarsH2}</h2>

      <div class="orbit-bento">
        {copy.pillars.map((p) => (
          <article class={`orbit-bento-card ${p.span}`}>
            <div>
              <div class="orbit-bento-tag">{p.tag}</div>
              <h3 class="orbit-bento-title">{p.title}</h3>
              <p class="orbit-bento-body">{p.body}</p>
            </div>
            <div>
              <div class="orbit-chip-row" style="margin-bottom: 14px;">
                {p.chips.map((c) => (
                  <span class="orbit-chip">{c}</span>
                ))}
              </div>
              <a class="orbit-bento-link" href={p.href}>
                {p.cta}
                <span aria-hidden="true">→</span>
              </a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ===================================================================== -->
  <!-- 5. COPYABLE QUICKSTART TERMINAL & DOCS ENTRY                          -->
  <!-- ===================================================================== -->
  <section class="orbit-section orbit-section-tight">
    <div class="orbit-wrap">
      <div class="orbit-qs-grid">
        <div>
          <span class="orbit-eyebrow">{copy.qsEyebrow}</span>
          <h2 class="orbit-h2">{copy.qsH2}</h2>
          <p class="orbit-lead">{copy.qsLead}</p>
          <div class="orbit-cta-row">
            <a class="orbit-btn orbit-btn-primary" href={`${prefix}/getting-started/quickstart/`}>
              {copy.qsCta1}
              <span aria-hidden="true">→</span>
            </a>
            <a class="orbit-btn orbit-btn-secondary" href={`${prefix}/reference/cli-and-architecture/`}>
              {copy.qsCta2}
            </a>
          </div>
        </div>

        <div class="orbit-terminal">
          <div class="orbit-terminal-bar">
            <span>{copy.terminalLabel}</span>
            <button
              type="button"
              class="orbit-copy-btn"
              data-copy-btn
              data-copy-text={installSnippet}
              data-label-idle={copy.copyIdle}
              data-label-done={copy.copyDone}
            >
              {copy.copyIdle}
            </button>
          </div>
          <pre class="orbit-terminal-code"><code><span class="orbit-cmd-comment"># 1. Install single static binary (SHA-256 verified)</span>
<span class="orbit-cmd-prompt">$ </span>curl -fsSL https://raw.githubusercontent.com/danielgaoyy/orbit/main/deploy/install.sh | sh

<span class="orbit-cmd-comment"># 2. Probe installed coding agents &amp; kernel sandbox</span>
<span class="orbit-cmd-prompt">$ </span>orbit doctor

<span class="orbit-cmd-comment"># 3. Start loopback daemon (127.0.0.1:6868) &amp; print QR pairing URI</span>
<span class="orbit-cmd-prompt">$ </span>orbit daemon up
<span class="orbit-cmd-prompt">$ </span>orbit pair</code></pre>
        </div>
      </div>
    </div>
  </section>

  <footer class="orbit-footer-band">
    <div class="orbit-wrap orbit-footer-row">
      <span>{copy.footerLeft}</span>
      <nav class="orbit-footer-links" aria-label="Documentation links">
        {copy.footerLinks.map((lnk) => (
          <a href={lnk.href}>{lnk.label}</a>
        ))}
      </nav>
    </div>
  </footer>
</div>

<script>
  // Minimal progressive enhancement: topology mode toggle, Light/Dark screenshot preview sync, and clipboard copy.
  (() => {
    const root = document.querySelector("[data-orbit-landing]");
    if (!root) return;

    // 1. Interactive Personal Agent Topology Scenario Tabs
    const topoRoot = root.querySelector("[data-topo-root]");
    if (topoRoot) {
      const tabBtns = topoRoot.querySelectorAll<HTMLButtonElement>("[data-topo-tab]");
      const activeTag = topoRoot.querySelector<HTMLElement>("[data-topo-active-tag]");
      const activeSummary = topoRoot.querySelector<HTMLElement>("[data-topo-active-summary]");
      const svgBanner = topoRoot.querySelector<SVGTextElement>("[data-svg-banner]");
      const flowDispatch = topoRoot.querySelector<SVGElement>('[data-flow="dispatch"]');
      const flowGuardian = topoRoot.querySelector<SVGElement>('[data-flow="guardian"]');

      const setMode = (btn: HTMLButtonElement) => {
        const mode = btn.dataset.topoTab || "dispatch";
        topoRoot.setAttribute("data-mode", mode);
        tabBtns.forEach((b) => b.setAttribute("aria-pressed", b === btn ? "true" : "false"));
        if (activeTag) {
          activeTag.textContent = btn.dataset.topoTag || "";
          activeTag.setAttribute("data-tone", btn.dataset.topoTone || "success");
        }
        if (activeSummary) {
          activeSummary.textContent = btn.dataset.topoSummary || "";
        }
        if (svgBanner) {
          const attr =
            mode === "guardian"
              ? "bannerGuardian"
              : mode === "shim"
                ? "bannerShim"
                : "bannerDispatch";
          svgBanner.textContent = svgBanner.dataset[attr] || "";
        }
        if (flowGuardian && flowDispatch) {
          flowGuardian.style.opacity = mode === "guardian" ? "1" : "0.35";
          flowDispatch.style.opacity = mode === "guardian" ? "0.45" : "1";
        }
      };

      tabBtns.forEach((btn) => btn.addEventListener("click", () => setMode(btn)));
    }

    // 2. Light / Dark Desktop Screenshot Switcher (auto-follows Starlight theme until manually toggled)
    const previewBtns = root.querySelectorAll<HTMLButtonElement>("[data-preview-theme]");
    const previewImgs = root.querySelectorAll<HTMLImageElement>("[data-preview-img]");
    let userPinnedPreview = false;

    const setPreview = (theme: string) => {
      previewBtns.forEach((b) =>
        b.setAttribute("aria-pressed", b.dataset.previewTheme === theme ? "true" : "false"),
      );
      previewImgs.forEach((img) =>
        img.setAttribute("data-visible", img.dataset.previewImg === theme ? "true" : "false"),
      );
    };

    const syncFromDocumentTheme = () => {
      if (userPinnedPreview) return;
      const docTheme = document.documentElement.dataset.theme === "light" ? "light" : "dark";
      setPreview(docTheme);
    };

    syncFromDocumentTheme();
    const observer = new MutationObserver(syncFromDocumentTheme);
    observer.observe(document.documentElement, {
      attributes: true,
      attributeFilter: ["data-theme"],
    });

    previewBtns.forEach((btn) =>
      btn.addEventListener("click", () => {
        userPinnedPreview = true;
        setPreview(btn.dataset.previewTheme || "dark");
      }),
    );

    // 3. Copy Quickstart Snippet
    const copyBtn = root.querySelector<HTMLButtonElement>("[data-copy-btn]");
    if (copyBtn) {
      copyBtn.addEventListener("click", async () => {
        const text = copyBtn.dataset.copyText || "";
        try {
          await navigator.clipboard.writeText(text);
          copyBtn.textContent = copyBtn.dataset.labelDone || "Copied";
          window.setTimeout(() => {
            copyBtn.textContent = copyBtn.dataset.labelIdle || "Copy";
          }, 1800);
        } catch {
          // Clipboard unavailable in restricted contexts
        }
      });
    }
  })();
</script>
